#!/usr/bin/env bash
# A ready marker publishes two translation units as one generation.
set -euo pipefail

CXX="@CMAKE_CXX_COMPILER@"
SRC="@CMAKE_CURRENT_SOURCE_DIR@"
HERE="@CMAKE_CURRENT_BINARY_DIR@"
WORK="${1:-$(mktemp -d /tmp/neko-multi-tu.XXXXXX)}"
OUT="$WORK/out.txt"
: > "$OUT"

BASE="-std=c++20 -O0 -fno-pie -fno-pic -fno-exceptions -fno-asynchronous-unwind-tables"
MANIFEST="$WORK/generation.ready"
STOP="$WORK/stop"

runner_pid=""
cleanup() { [ -n "$runner_pid" ] && kill "$runner_pid" 2>/dev/null || true; }
trap cleanup EXIT

fail() { echo "FAIL: $1"; tail -10 "$OUT"; exit 1; }
wait_count() { # pattern min timeout label
  local pattern="$1" min="$2" timeout="$3" label="$4" waited=0 n
  while :; do
    n=$(grep -ac -- "$pattern" "$OUT" || true)
    [ "$n" -ge "$min" ] && return 0
    sleep 0.15; waited=$((waited + 1))
    if [ "$waited" -gt $((timeout * 6)) ]; then
      echo "FAIL($label): '$pattern' x$n < $min"; tail -10 "$OUT"; exit 1
    fi
  done
}
wait_after() { # pattern first-line timeout label
  local pattern="$1" first="$2" timeout="$3" label="$4" waited=0
  while :; do
    awk -v pattern="$pattern" -v first="$first" \
      'NR >= first && $0 ~ pattern { found = 1 } END { exit !found }' "$OUT" && return 0
    sleep 0.15; waited=$((waited + 1))
    if [ "$waited" -gt $((timeout * 6)) ]; then
      echo "FAIL($label): no new '$pattern'"; tail -10 "$OUT"; exit 1
    fi
  done
}
build_a() { # generation value
  local generation="$1" value="$2" dir="$WORK/$1"
  mkdir -p "$dir"
  printf 'int a_value() { return %s; }\n' "$value" > "$dir/a.variant.cpp"
  "$CXX" $BASE -c "$dir/a.variant.cpp" -o "$dir/a.staging.o"
  mv "$dir/a.staging.o" "$dir/a.o"
}
build_b() { # generation value include-unpatchable-guard
  local generation="$1" value="$2" guard="$3" dir="$WORK/$1"
  mkdir -p "$dir"
  printf 'int b_value() { return %s; }\n' "$value" > "$dir/b.variant.cpp"
  if [ "$guard" = 1 ]; then
    printf '%s\n' '__attribute__((naked)) void b_guard() { __asm__ volatile("nop\n\tnop\n\tnop\n\tnop\n\tnop\n\tnop\n\tnop\n\tret"); }' >> "$dir/b.variant.cpp"
  fi
  "$CXX" $BASE -c "$dir/b.variant.cpp" -o "$dir/b.staging.o"
  mv "$dir/b.staging.o" "$dir/b.o"
}
publish() { # generation
  local generation="$1" dir="$WORK/$1" staging="$MANIFEST.staging"
  {
    printf 'nekomata-generation-v1\n'
    printf 'id "%s"\n' "$generation"
    printf 'changed "%s"\n' "$SRC/a.cpp"
    printf 'changed "%s"\n' "$SRC/b.cpp"
    printf 'object "%s" "%s" "%s"\n' "$dir/a.o" "$SRC/a.cpp" "$BASE"
    printf 'object "%s" "%s" "%s"\n' "$dir/b.o" "$SRC/b.cpp" "$BASE"
  } > "$staging"
  mv "$staging" "$MANIFEST"
}

echo "== neko.multi_tu (workdir: $WORK) =="

"$HERE/multi_tu_runner" "$MANIFEST" "$STOP" > "$OUT" 2>&1 &
runner_pid=$!
wait_count '\[pair 1 1\]' 2 10 startup

# One completed object is not observable before the ready marker publishes the
# complete generation.
build_a g2 2
wait_count '\[pair 1 1\]' 4 5 g2-not-published
if grep -aq "reload generation 'g2' applied" "$OUT"; then
  fail "partial generation applied before publication"
fi
build_b g2 2 0
publish g2
wait_count "reload generation 'g2' applied: 2 function(s) redirected" 1 15 v2-applied
wait_count '\[pair 2 2\]' 2 15 v2-live

# B's unpatchable guard rejects the generation during preparation. A must not
# become visible even though its object was prepared first.
v3_line=$(( $(wc -l < "$OUT") + 1 ))
build_a g3 3
build_b g3 3 1
publish g3
wait_after 'rejected before any write: cannot patch entry of .*b_guard' "$v3_line" 15 v3-rejected
wait_after '\[pair 2 2\]' "$v3_line" 5 v2-still-live
sleep 0.5
if grep -aq '\[pair 3 3\]' "$OUT"; then
  fail "rejected generation became visible"
fi

# The next complete generation still applies after the rejection.
build_a g4 4
build_b g4 4 0
publish g4
wait_count "reload generation 'g4' applied: 2 function(s) redirected" 1 15 v4-applied
wait_count '\[pair 4 4\]' 2 15 v4-live

if awk '/\[pair / { gsub(/]/, "", $3); if ($2 != $3) mixed = 1 } END { exit !mixed }' "$OUT"; then
  fail "observed a mixed-TU generation"
fi

touch "$STOP"
wait "$runner_pid" || fail "runner exited unsuccessfully"
runner_pid=""

echo "MULTI-TU PASS — two objects committed and rejected as indivisible generations"
echo "output kept at: $OUT"
