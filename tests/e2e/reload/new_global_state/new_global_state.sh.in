#!/usr/bin/env bash
# New mutable state keeps one identity across complete generations. Rejected
# candidates never publish their storage, and an omitted symbol can later be
# reintroduced without re-running its initializer.
set -euo pipefail

CXX="@CMAKE_CXX_COMPILER@"
HERE="@CMAKE_CURRENT_BINARY_DIR@"
WORK="${1:-$(mktemp -d /tmp/neko-new-global-state.XXXXXX)}"
OUT="$WORK/out.txt"
BASE="-std=c++20 -O0 -fno-pie -fno-pic -fno-exceptions -fno-asynchronous-unwind-tables"
PUB="$WORK/neko-new-global-state/new-global-state-e2e"
: > "$OUT"

runner_pid=""
cleanup() { [ -n "$runner_pid" ] && kill "$runner_pid" 2>/dev/null || true; }
trap cleanup EXIT

fail() { echo "FAIL: $1"; tail -25 "$OUT"; exit 1; }
wait_for() { # pattern min timeout label
  local pattern="$1" min="$2" timeout="$3" label="$4" waited=0 found
  while :; do
    found=$(grep -ac -- "$pattern" "$OUT" || true)
    [ "$found" -ge "$min" ] && return 0
    sleep 0.1
    waited=$((waited + 1))
    if [ "$waited" -gt $((timeout * 10)) ]; then
      echo "FAIL($label): '$pattern' x$found < $min"
      tail -25 "$OUT"
      exit 1
    fi
  done
}

write_a() { # version output
  local version="$1" output="$2"
  local local_initial=900 retry_definition=""
  [ "$version" -eq 2 ] && local_initial=10
  case "$version" in
    4) retry_definition='static int retry_state = 700; extern "C" int state_retry_value() { return retry_state++; }' ;;
    5) retry_definition='static int retry_state = 7; extern "C" int state_retry_value() { return retry_state++; }' ;;
    7) retry_definition='static int retry_state = 900; extern "C" int state_retry_value() { return retry_state++; }' ;;
    8) retry_definition='static long retry_state = 900; extern "C" int state_retry_value() { return static_cast<int>(retry_state++); }' ;;
  esac
  {
    echo 'extern "C" int shared_state;'
    printf 'static int local_state = %d;\n' "$local_initial"
    printf 'extern "C" int state_marker() { return %d; }\n' "$version"
    echo 'extern "C" int state_a_value() { return ++local_state; }'
    echo 'extern "C" int state_shared_value() { return shared_state; }'
    [ -z "$retry_definition" ] || echo "$retry_definition"
  } > "$output"
}

write_b() { # version output
  local version="$1" output="$2"
  local local_initial=800 shared_initial=700
  [ "$version" -eq 2 ] && local_initial=20
  [ "$version" -eq 2 ] && shared_initial=100
  {
    printf 'static int local_state = %d;\n' "$local_initial"
    echo 'extern "C" {'
    printf 'int shared_state = %d;\n' "$shared_initial"
    echo '}'
    echo 'extern "C" int state_b_value() {'
    echo '  ++local_state;'
    echo '  shared_state += 11;'
    echo '  return local_state;'
    echo '}'
    if [ "$version" -eq 4 ]; then
      echo '__attribute__((naked)) void state_unpatchable_guard() {'
      printf '%s\n' '  __asm__ volatile("nop\n\tnop\n\tnop\n\tnop\n\tnop\n\tnop\n\tnop\n\tret");'
      echo '}'
    fi
  } > "$output"
}

publish() { # version sequence
  local version="$1" sequence="$2" member digest
  local dir="$WORK/v$version"
  mkdir -p "$dir"
  write_a "$version" "$dir/a.cpp"
  write_b "$version" "$dir/b.cpp"
  for member in a b; do
    "$CXX" $BASE -c "$dir/$member.cpp" -o "$dir/$member.o"
  done

  local generation="$PUB/generations/gen-$sequence"
  mkdir -p "$generation/objects" "$PUB/offers"
  cp "$dir/a.o" "$generation/objects/a.o"
  cp "$dir/b.o" "$generation/objects/b.o"
  {
    printf 'nekomata-generation/2\n'
    printf 'group_id "//state:lifecycle"\n'
    printf 'sequence %s\n' "$sequence"
    printf 'generation_id "gen-%s"\n' "$sequence"
    printf 'compatibility_id "new-global-state-compatibility"\n'
    printf 'abi_id "elf-e2e-patch"\n'
    for member in a b; do
      digest=$(sha256sum "$generation/objects/$member.o" | cut -d' ' -f1)
      printf 'member "state/%s" "objects/%s.o" "%s" "//new_global_state:%s.cpp" "%s"\n' \
        "$member" "$member" "$digest" "$member" "$BASE"
    done
    printf 'changed_input "//new_global_state:a.cpp"\n'
  } > "$generation/manifest.staging"
  mv "$generation/manifest.staging" "$generation/manifest"
  : > "$PUB/offers/$sequence-gen-$sequence.ready.staging"
  mv "$PUB/offers/$sequence-gen-$sequence.ready.staging" \
    "$PUB/offers/$sequence-gen-$sequence.ready"
}

# Runtime diagnostics and runner output share one sink. A diagnostic prefix can
# be written immediately before a complete runner record, so recognize the
# marker anywhere on the line while still parsing every state field exactly.
field() { # marker first|last field
  local marker="$1" position="$2" name="$3"
  if [ "$position" = first ]; then
    grep -a "marker=$marker " "$OUT" | head -1 | sed -n "s/.* $name=\(-*[0-9]*\).*/\1/p"
  else
    grep -a "marker=$marker " "$OUT" | tail -1 | sed -n "s/.* $name=\(-*[0-9]*\).*/\1/p"
  fi
}

assert_continuity() { # old-marker new-marker
  local old_marker="$1" new_marker="$2" name old_value new_value delta
  for name in a b shared; do
    old_value=$(field "$old_marker" last "$name")
    new_value=$(field "$new_marker" first "$name")
    [ -n "$old_value" ] && [ -n "$new_value" ] || fail "missing $name transition sample"
    delta=1
    [ "$name" = shared ] && delta=11
    [ "$new_value" -eq $((old_value + delta)) ] || \
      fail "$name state reset across markers $old_marker -> $new_marker ($old_value -> $new_value)"
  done
}

echo "== neko.new_global_state (workdir: $WORK) =="

( cd "$WORK" && "$HERE/new_global_state_runner" ) > "$OUT" 2>&1 &
runner_pid=$!
wait_for 'marker=1 ' 3 10 baseline

publish 2 2
wait_for '^applied generation=gen-2$' 1 20 applied-v2
wait_for 'marker=2 ' 3 10 live-v2
[ "$(field 2 first a)" -eq 11 ] || fail "A's new local did not use its initializer"
[ "$(field 2 first b)" -eq 21 ] || fail "B's same-named local aliased A or initialized incorrectly"
[ "$(field 2 first shared)" -eq 111 ] || fail "new external state initialized incorrectly"

publish 3 3
wait_for '^applied generation=gen-3$' 1 20 applied-v3
wait_for 'marker=3 ' 3 10 live-v3
assert_continuity 2 3

publish 4 4
wait_for 'reload failed: reload rejected before any write: cannot patch entry of .*state_unpatchable_guardv' \
  1 20 rejected-v4
v3_count=$(grep -ac 'marker=3 ' "$OUT")
wait_for 'marker=3 ' $((v3_count + 3)) 10 v3-still-live
grep -aq 'marker=4 ' "$OUT" && fail "rejected generation became observable"

publish 5 5
wait_for '^applied generation=gen-5$' 1 20 applied-v5
wait_for 'marker=5 ' 3 10 live-v5
assert_continuity 3 5
[ "$(field 5 first retry)" -eq 7 ] || fail "rejected storage was published or retry initialized twice"

publish 6 6
wait_for '^applied generation=gen-6$' 1 20 applied-v6
wait_for 'marker=6 ' 3 10 live-v6
assert_continuity 5 6

publish 7 7
wait_for '^applied generation=gen-7$' 1 20 applied-v7
wait_for 'marker=7 ' 3 10 live-v7
assert_continuity 6 7
retry_before=$(field 6 last retry)
retry_after=$(field 7 first retry)
[ "$retry_after" -eq $((retry_before + 1)) ] || \
  fail "reintroduced state lost its identity ($retry_before -> $retry_after)"

publish 8 8
wait_for "reload failed: global '.*' changed layout" 1 20 rejected-v8
v7_count=$(grep -ac 'marker=7 ' "$OUT")
wait_for 'marker=7 ' $((v7_count + 3)) 10 v7-still-live
grep -aq 'marker=8 ' "$OUT" && fail "layout-changing generation became observable"

kill "$runner_pid" 2>/dev/null || true
wait "$runner_pid" 2>/dev/null || true
runner_pid=""

[ "$(grep -ac '^applied generation=' "$OUT")" -eq 5 ] || \
  fail "expected exactly five accepted generations"
[ "$(grep -ac '^reload failed:' "$OUT")" -eq 2 ] || \
  fail "expected exactly two rejected generations"

echo "NEW-GLOBAL-STATE PASS — identities survived reload, rejection, removal, and reintroduction"
echo "output kept at: $OUT"
