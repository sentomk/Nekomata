#!/usr/bin/env bash
# Managed watch end to end: an embedded descriptor is discovered through the
# linker section, its generation stream is consumed at update(), unwatch()
# pauses observation, and re-watch resumes from the cursor without replay.
set -euo pipefail

CXX="@CMAKE_CXX_COMPILER@"
SRC="@CMAKE_CURRENT_SOURCE_DIR@"
HERE="@CMAKE_CURRENT_BINARY_DIR@"
WORK="${1:-$(mktemp -d /tmp/neko-managed.XXXXXX)}"
OUT="$WORK/out.txt"
: > "$OUT"

BASE="-std=c++20 -O0 -fno-pie -fno-pic -fno-exceptions -fno-asynchronous-unwind-tables"
PUB="$WORK/neko-managed-watch/managed-watch-e2e"

runner_pid=""
cleanup() { [ -n "$runner_pid" ] && kill "$runner_pid" 2>/dev/null || true; }
trap cleanup EXIT

fail() { echo "FAIL: $1"; tail -15 "$OUT"; exit 1; }
wait_for() { # pattern min timeout label
  local pattern="$1" min="$2" timeout="$3" label="$4" waited=0 n
  while :; do
    n=$(grep -ac -- "$pattern" "$OUT" || true)
    [ "$n" -ge "$min" ] && return 0
    sleep 0.15; waited=$((waited + 1))
    if [ "$waited" -gt $((timeout * 6)) ]; then
      echo "FAIL($label): '$pattern' x$n < $min"; tail -15 "$OUT"; exit 1
    fi
  done
}

# Compile one hot version and publish it as an immutable generation.
publish() { # version sequence
  local version="$1" sequence="$2"
  local gen="$PUB/generations/gen-$sequence"
  mkdir -p "$gen/objects" "$PUB/offers"
  sed "s/10 + 1;/10 + $version;/" "$SRC/managed_hot.cpp" > "$WORK/hot.v$version.cpp"
  "$CXX" $BASE -c "$WORK/hot.v$version.cpp" -o "$gen/objects/hot.staging.o"
  mv "$gen/objects/hot.staging.o" "$gen/objects/hot.o"
  local digest
  digest=$(sha256sum "$gen/objects/hot.o" | cut -d' ' -f1)
  {
    printf 'nekomata-generation 2\n'
    printf 'group_id "//managed:hot"\n'
    printf 'sequence %s\n' "$sequence"
    printf 'generation_id "gen-%s"\n' "$sequence"
    printf 'compatibility_id "e2e-compatibility"\n'
    printf 'abi_id "elf-e2e-patch"\n'
    printf 'member "managed/hot" "objects/hot.o" "%s" "//managed_reload:managed_hot.cpp" "%s"\n' \
      "$digest" "$BASE"
    printf 'changed_input "//managed_reload:managed_hot.cpp"\n'
  } > "$gen/manifest.staging"
  mv "$gen/manifest.staging" "$gen/manifest"
  : > "$PUB/offers/$sequence-gen-$sequence.ready.staging"
  mv "$PUB/offers/$sequence-gen-$sequence.ready.staging" "$PUB/offers/$sequence-gen-$sequence.ready"
}

echo "== neko.managed_reload (workdir: $WORK) =="

( cd "$WORK" && "$HERE/managed_reload_runner" 60 40 60 ) > "$OUT" 2>&1 &
runner_pid=$!

# While watched, v2 applies and preserves baseline state. An enabled group is
# under background-preparation observation.
wait_for 'tick=' 3 10 startup
wait_for 'state=preparing' 1 10 preparing
wait_for 'tick=[0-9]*1$' 3 10 v1-live
publish 2 2
wait_for '^applied$' 1 15 v2-applied
wait_for 'tick=[0-9]*2$' 3 15 v2-live

# While unwatched, publishing v3 must not apply it.
wait_for 'phase=unwatched' 1 30 phase2
wait_for 'state=idle' 1 10 unwatched-idle
publish 3 3
if awk '/phase=unwatched/{seen=1} /phase=resumed/{seen=0} seen && /^applied$/{bad=1} END{exit !bad}' "$OUT"; then
  fail "generation applied while unwatched"
fi

# After resuming, v3 applies through the same session and ticks keep counting.
wait_for 'phase=resumed' 1 30 phase3
wait_for '^applied$' 2 20 v3-applied
wait_for 'tick=[0-9]*3$' 3 15 v3-live

wait "$runner_pid" || fail "runner exited unsuccessfully"
runner_pid=""

# Tick values rise strictly across every watch transition and reload.
if ! grep -o 'tick=[0-9]*' "$OUT" | cut -d= -f2 | \
     awk 'NR>1 && $1+0 <= prev+0 {bad=1} {prev=$1} END{exit bad?1:0}'; then
  fail "tick counter reset or replayed"
fi
if [ "$(grep -c '^applied$' "$OUT")" -ne 2 ]; then
  fail "expected exactly two applied generations"
fi

echo "MANAGED RELOAD PASS — discovered, applied, unwatched, resumed"
echo "output kept at: $OUT"
