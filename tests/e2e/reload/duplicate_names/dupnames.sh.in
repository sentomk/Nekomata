#!/usr/bin/env bash
# neko.dupnames — same-named statics across TUs must not cross-patch.
#
# The host links a.cpp + b.cpp, both defining static int value(). The edited A
# also adds two static names from B, making B the stronger symbol-set match.
# With an explicit source identity, A must still be selected deterministically.
# Without a manifest, the offer must be rejected rather than guessed.
set -euo pipefail

CXX="@CMAKE_CXX_COMPILER@"
SRC="@CMAKE_CURRENT_SOURCE_DIR@"
HERE="@CMAKE_CURRENT_BINARY_DIR@"
CLI=""
WORK=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cli) CLI="$2"; shift 2 ;;
    *)     WORK="$1"; shift ;;
  esac
done
WORK="${WORK:-$(mktemp -d /tmp/neko-dup.XXXXXX)}"
OUT="$WORK/out.txt"
: > "$OUT"

BASE="-std=c++20 -O0 -fno-pie -fno-pic -fno-exceptions -fno-asynchronous-unwind-tables"

runner_pid=""
manifest_path="$HERE/dup_runner.nekomata-map"
cleanup() {
  [ -n "$runner_pid" ] && kill "$runner_pid" 2>/dev/null || true
  rm -f "$manifest_path"
}
trap cleanup EXIT

fail() { echo "FAIL: $1"; tail -6 "$OUT"; exit 1; }
wait_count() {
  local pattern="$1" min="$2" timeout="$3" label="$4" waited=0 n
  while :; do
    n=$(grep -ac -- "$pattern" "$OUT" || true)
    [ "$n" -ge "$min" ] && return 0
    sleep 0.15; waited=$((waited + 1))
    if [ "$waited" -gt $((timeout * 6)) ]; then
      echo "FAIL($label): '$pattern' x$n < $min"; tail -5 "$OUT"; exit 1
    fi
  done
}

echo "== neko.dupnames (workdir: $WORK) =="

manifest_ready=0
if [ -n "$CLI" ]; then
  if ! "$CLI" manifest "$HERE/dup_runner" > "$manifest_path" 2>/dev/null; then
    echo "FAIL: symbol manifest generation failed"
    exit 1
  fi
  manifest_ready=1
else
  rm -f "$manifest_path"
fi

runner_args=("$WORK/dup.new.o")
if [ "$manifest_ready" = 1 ]; then
  # Lexical spelling is not identity: `./` must normalize to the manifest's
  # source path without requiring filesystem canonicalization.
  runner_args+=("$SRC/./a.cpp")
fi
"$HERE/dup_runner" "${runner_args[@]}" > "$OUT" 2>&1 &
runner_pid=$!
wait_count '\[a=1 b=2\]' 3 10 startup
if [ "$manifest_ready" = 1 ]; then
  wait_count "symbol manifest loaded" 1 5 manifest_loaded
fi

# a.cpp v2: same-named static now returns 100, and two new functions make its
# symbol-set overlap with b.cpp stronger than with the original a.cpp.
"$CXX" $BASE -c "$SRC/a_v2.cpp" -o "$WORK/dup.new.o"

if [ "$manifest_ready" = 1 ]; then
  wait_count "reload applied" 1 15 reload
  wait_count '\[a=100 b=2\]' 3 10 source_selected
  if grep -aq 'b=100' "$OUT"; then
    fail "b.cpp's same-named static was patched — source identity was ignored"
  fi
  echo "DUPNAMES PASS — explicit source selected a.cpp despite stronger overlap with b.cpp"
else
  wait_count "ambiguous" 1 15 ambiguous_rejection
  sleep 0.8
  kill -0 "$runner_pid" 2>/dev/null || fail "runner died on the ambiguous offer"
  if grep -aq '\[a=100' "$OUT" || grep -aq 'b=100' "$OUT"; then
    fail "code was patched despite missing source evidence"
  fi
  wait_count '\[a=1 b=2\]' 1 5 unchanged
  echo "DUPNAMES PASS — ambiguous symbol refused without a manifest"
fi

kill "$runner_pid" 2>/dev/null || true; wait "$runner_pid" 2>/dev/null || true; runner_pid=""

echo ""
echo "output kept at: $OUT"
