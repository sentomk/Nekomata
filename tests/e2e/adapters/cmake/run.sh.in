#!/usr/bin/env bash
# CMake adapter end to end: a fixture project consumes
# nekomata_add_reload_group(), publishes through the native build graph, and
# the documented runtime integration applies generations at update().
# Invoked once per (generator, group form) cell so each combination reports
# independently: run.sh <Ninja|Unix Makefiles> <sources|units>.
set -euo pipefail

GENERATOR="${1:?usage: run.sh <generator> <sources|units>}"
SCOPE="${2:?usage: run.sh <generator> <sources|units>}"

CMAKE="@CMAKE_COMMAND@"
CXX="@CMAKE_CXX_COMPILER@"
MAKE_PROGRAM="@CMAKE_MAKE_PROGRAM@"
SRC="@CMAKE_CURRENT_SOURCE_DIR@/project"
NEKO="@PROJECT_SOURCE_DIR@"
WORK="$(mktemp -d /tmp/neko-cmake-adapter.XXXXXX)"
OUT="$WORK/out.txt"

runner_pid=""
cleanup() { [ -n "$runner_pid" ] && kill "$runner_pid" 2>/dev/null || true; }
trap cleanup EXIT

fail() { echo "FAIL: $1"; tail -20 "$OUT"; exit 1; }
wait_for() { # pattern min timeout label
  local pattern="$1" min="$2" timeout="$3" label="$4" waited=0 n
  while :; do
    n=$(grep -ac -- "$pattern" "$OUT" || true)
    [ "$n" -ge "$min" ] && return 0
    sleep 0.15; waited=$((waited + 1))
    if [ "$waited" -gt $((timeout * 6)) ]; then
      echo "FAIL($label): '$pattern' x$n < $min"; tail -20 "$OUT"; exit 1
    fi
  done
}

prepare_round() { # generator -> echoes the round directory
  local generator="$1"
  local round="$WORK/${generator// /-}"
  rm -rf "$round"
  mkdir -p "$round"
  cp -r "$SRC" "$round/project"
  : > "$OUT"

  # The pinned Ninja belongs to the Ninja generator only; Makefiles finds
  # its own make.
  local make_program_args=()
  [ "$generator" = "Ninja" ] && make_program_args=(-DCMAKE_MAKE_PROGRAM="$MAKE_PROGRAM")
  "$CMAKE" -S "$round/project" -B "$round/build" -G "$generator" \
    -DCMAKE_BUILD_TYPE=Debug -DNEKOMATA_SOURCE_DIR="$NEKO" \
    -DCMAKE_CXX_COMPILER="$CXX" \
    "${make_program_args[@]}" > "$round/configure.log" 2>&1 \
    || { cp "$round/configure.log" "$OUT"; fail "$generator configure"; }
  "$CMAKE" --build "$round/build" --target adapter_demo > "$round/build.log" 2>&1 \
    || { cp "$round/build.log" "$OUT"; fail "$generator baseline build"; }
  "$CMAKE" --build "$round/build" --target adapter_mixed > "$round/build_mixed.log" 2>&1 \
    || { cp "$round/build_mixed.log" "$OUT"; fail "$generator mixed baseline build"; }

  echo "$round"
}

run_sources() { # generator round
  local generator="$1" round="$2"
  "$round/build/adapter_demo" 600 > "$OUT" 2>&1 &
  runner_pid=$!
  wait_for 'tick=[0-9]*1$' 3 20 "$generator v1-live"

  # The first publication carries baseline-identical code: it must apply
  # without changing behavior.
  "$CMAKE" --build "$round/build" --target demo_hot_reload > "$round/publish1.log" 2>&1 \
    || { cp "$round/publish1.log" "$OUT"; fail "$generator first publication"; }
  wait_for '^applied$' 1 20 "$generator baseline publication applied"

  sed -i.bak 's/10 + 1;/10 + 3;/' "$round/project/hot.cpp"
  "$CMAKE" --build "$round/build" --target demo_hot_reload > "$round/publish2.log" 2>&1 \
    || { cp "$round/publish2.log" "$OUT"; fail "$generator republish"; }
  wait_for '^applied$' 2 20 "$generator v3-applied"
  wait_for 'tick=[0-9]*3$' 3 20 "$generator v3-live"

  kill "$runner_pid" 2>/dev/null || true
  wait "$runner_pid" 2>/dev/null || true
  runner_pid=""

  if ! grep -o 'tick=[0-9]*' "$OUT" | cut -d= -f2 | \
       awk 'NR>1 && $1+0 <= prev+0 {bad=1} {prev=$1} END{exit bad?1:0}'; then
    fail "$generator tick counter reset or replayed"
  fi
  if [ "$(grep -c '^applied$' "$OUT")" -ne 2 ]; then
    fail "$generator expected exactly two applied generations"
  fi
}

run_units() { # generator round
  local generator="$1" round="$2"
  : > "$OUT"
  "$round/build/adapter_mixed" 400 > "$OUT" 2>&1 &
  runner_pid=$!

  # The baseline must carry unit A's define (variant digit 2) and unit B's
  # default (units digit 1).
  wait_for 'phys=[0-9]*2 ' 3 20 "$generator mixed phys variant live"
  wait_for 'extra=[0-9]*1$' 3 20 "$generator mixed extra v1 live"

  # First publication: baseline-identical, must apply.
  "$CMAKE" --build "$round/build" --target mixed_hot_reload > "$round/publish_mixed1.log" 2>&1 \
    || { cp "$round/publish_mixed1.log" "$OUT"; fail "$generator mixed first publication"; }
  wait_for '^applied$' 1 20 "$generator mixed baseline applied"

  # Edit only unit B's source; the full group (both units) must republish.
  sed -i.bak 's/10 + 1;/10 + 5;/' "$round/project/extra.cpp"
  "$CMAKE" --build "$round/build" --target mixed_hot_reload > "$round/publish_mixed2.log" 2>&1 \
    || { cp "$round/publish_mixed2.log" "$OUT"; fail "$generator mixed republish"; }
  wait_for '^applied$' 2 20 "$generator mixed v5-applied"
  wait_for 'extra=[0-9]*5$' 3 20 "$generator mixed extra v5 live"
  # Unit A's variant digit must be untouched by unit B's edit.
  wait_for 'phys=[0-9]*2 ' 1 20 "$generator mixed phys still variant 2"

  kill "$runner_pid" 2>/dev/null || true
  wait "$runner_pid" 2>/dev/null || true
  runner_pid=""

  if ! grep -o 'extra=[0-9]*' "$OUT" | cut -d= -f2 | \
       awk 'NR>1 && $1+0 <= prev+0 {bad=1} {prev=$1} END{exit bad?1:0}'; then
    fail "$generator mixed extra counter reset or replayed"
  fi
}

echo "== neko.e2e.adapters.cmake: $GENERATOR ($SCOPE groups, workdir: $WORK) =="
ROUND="$(prepare_round "$GENERATOR")"
case "$SCOPE" in
  sources) run_sources "$GENERATOR" "$ROUND" ;;
  units) run_units "$GENERATOR" "$ROUND" ;;
  *) echo "FAIL: unknown scope '$SCOPE'"; exit 1 ;;
esac
echo "CMAKE ADAPTER PASS — $GENERATOR, $SCOPE groups"
echo "output kept at: $OUT"
