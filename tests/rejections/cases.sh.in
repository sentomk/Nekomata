#!/usr/bin/env bash
# neko.rejections — boundary tests: every known-bad input must be
# rejected with a SPECIFIC message, the process must survive, and the old
# code must keep running. One runner process absorbs all the broken drops
# sequentially; a second (PIE) runner asserts the startup rejection.
#
# Probe note: expected patterns below were first recorded by running each
# case on a real Linux machine.
set -euo pipefail

CXX="@CMAKE_CXX_COMPILER@"
SRC="@CMAKE_CURRENT_SOURCE_DIR@"
HERE="@CMAKE_CURRENT_BINARY_DIR@"
source "@PROJECT_SOURCE_DIR@/scripts/test_helpers.sh"
# The offline tool is an argument, not a configured path: configure_file()
# substitutes text at configure time and does not evaluate generator
# expressions, so the location of a built target has to arrive at run time.
WORK=""
CLI=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --cli) CLI="$2"; shift 2 ;;
    *)     WORK="$1"; shift ;;
  esac
done
WORK="${WORK:-$(mktemp -d /tmp/neko-reject.XXXXXX)}"

OUT="$WORK/out.txt"
STOP_FILE="$WORK/stop"
if [ -e "$STOP_FILE" ]; then echo "FAIL: use a fresh workdir"; exit 1; fi
: > "$OUT"

BASE="-std=c++20 -O0 -fno-pie -fno-pic -fno-exceptions -fno-asynchronous-unwind-tables"

runner_pid=""
cleanup() {
  if [ -n "$runner_pid" ]; then
    kill "$runner_pid" 2>/dev/null || true
    wait "$runner_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT

count() { grep -c -- "$1" "$OUT" || true; }

wait_for() { # <pattern> <timeout_s> <label> <cursor>
  wait_for_new "$1" "$2" "$3" "$OUT" "$4"
}

alive() { kill -0 "$runner_pid" 2>/dev/null; }

expect_case() { # expect_case <label> <staging.o> <expected pattern>
  local label="$1" staging="$2" pattern="$3"
  local cursor ticks_before
  cursor=$(log_cursor "$OUT")
  mv "$staging" "$WORK/bad.new.o"
  wait_for "$pattern" 15 "$label" "$cursor"
  ticks_before=$(count '\[hot\] tick')
  sleep 0.6 # let old code prove it keeps running
  alive || { echo "FAIL($label): runner died after the rejected reload"; exit 1; }
  local ticks_after
  ticks_after=$(count '\[hot\] tick')
  [ "$ticks_after" -gt "$ticks_before" ] || {
    echo "FAIL($label): old code stopped running after rejection"; exit 1; }
  echo "PASS $label"
}

build_variant() { # build_variant <sed-expr|-> <extra flags...> -> $WORK/staging.o
  local sedexpr="$1"; shift
  if [ "$sedexpr" = "-" ]; then
    cp "$SRC/hot.cpp" "$WORK/variant.cpp"
  else
    sed "$sedexpr" "$SRC/hot.cpp" > "$WORK/variant.cpp"
  fi
  "$CXX" $BASE "$@" -c "$WORK/variant.cpp" -o "$WORK/staging.o"
}

# build_arena_variant <page_size> <output> — compile hot.cpp with a .rodata
# pad so the laid-out image ends within the same page as its start while at
# least one trampoline follows (printf stays an undefined call). Section
# sizes are read from the object the same compiler produces; readelf and
# usable sizes are REQUIRED: silently skipping the pad would turn this case
# into an ordinary reload that exercises nothing.
build_arena_variant() { # build_arena_variant <page_size> <output>
  local page="$1" output="$2"
  cp "$SRC/hot.cpp" "$WORK/variant.cpp"
  case "$CXX" in
  *mock_compile.sh*)
    # The mock harness consumes publication events, not machine code; there
    # are no section sizes to read. Publish the unmodified source.
    "$CXX" $BASE -c "$WORK/variant.cpp" -o "$output"
    return 0
    ;;
  esac
  command -v readelf >/dev/null 2>&1 || {
    echo "FAIL(arena_boundary): readelf is required to size the boundary object"; exit 1; }
  "$CXX" $BASE -c "$WORK/variant.cpp" -o "$WORK/arena_probe.o"
  # Section names differ by compiler (GCC emits .rodata, clang splits into
  # .rodata.str1.1 and friends); the loader lays out every text/rodata-class
  # section in index order with 16-byte inter-section alignment. Simulate
  # that layout instead of assuming one section per class. Sizes are hex.
  local laid_out
  laid_out=$(readelf -SW "$WORK/arena_probe.o" | awk '
    function hex(s,  v, i, c, d) {
      v = 0
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        d = index("0123456789abcdef", tolower(c))
        if (!d) return -1
        v = v * 16 + d - 1
      }
      return v
    }
    {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^\.text/ || $i ~ /^\.rodata/) {
          s = hex($(i + 4))
          if (s >= 0) { cur = int((cur + 15) / 16) * 16; cur += s }
        }
      }
    }
    END { print cur + 0 }')
  [ -n "$laid_out" ] && [ "$laid_out" -gt 0 ] || {
    echo "FAIL(arena_boundary): cannot read text/rodata section sizes"; exit 1; }
  local pad
  pad=$(( laid_out < page ? page - laid_out - 3 : 0 ))
  printf '\nasm(".pushsection .rodata\\n.space %d\\n.popsection");\n' "$pad" \
    >> "$WORK/variant.cpp"
  "$CXX" $BASE -c "$WORK/variant.cpp" -o "$output"
}

echo "== neko.rejections (workdir: $WORK) =="

# ---- PIE host: fully supported — startup AND a live reload --------------
# The hot TU recipe follows the host: PIE hosts need -fpie objects (the
# linker rejects absolute relocations from -fno-pie code in a PIE link).
PIE_OUT="$WORK/pie_out.txt"
: > "$PIE_OUT"
pie_pid=""
"$HERE/reject_runner_pie" "$WORK/pie.new.o" > "$PIE_OUT" 2>&1 &
pie_pid=$!
pie_wait() { # pie_wait <pattern> <label>
  local pattern="$1" label="$2" waited=0
  while ! grep -aq -- "$pattern" "$PIE_OUT"; do
    sleep 0.2; waited=$((waited + 1))
    if [ "$waited" -gt 75 ]; then
      echo "FAIL(pie-$label): '$pattern' missing"; tail -4 "$PIE_OUT"; exit 1; fi
  done
}
if grep -aq "startup rejected" "$PIE_OUT"; then
  echo "FAIL(pie): startup rejected a PIE host"; tail -3 "$PIE_OUT"; exit 1
fi
pie_wait '\[hot\] tick' startup
"$CXX" -std=c++20 -O0 -fpie -fno-exceptions -fno-asynchronous-unwind-tables \
  -c "$SRC/hot.cpp" -o "$WORK/pie.staging.o"
mv "$WORK/pie.staging.o" "$WORK/pie.new.o"
pie_wait "reload applied" reload
sleep 0.5
kill -0 "$pie_pid" 2>/dev/null || { echo "FAIL(pie): runner died after reload"; exit 1; }
kill "$pie_pid" 2>/dev/null || true
wait "$pie_pid" 2>/dev/null || true
check_clean_log "$PIE_OUT"
echo "PASS pie_host (startup + live reload under ASLR)"

# ---- one runner absorbs all broken drops ---------------------------------
"$CXX" $BASE -c "$SRC/hot.cpp" -o "$WORK/baseline.o"

# The disambiguation cases need the offline map, and the fixture is now
# ordinary: the inspector reads DWARF 5 and skips inlined instances, so no
# special build flags are involved. Generate it before starting the process:
# process_symbols loads the map once, while the reload session is constructed.
manifest_path="$HERE/reject_runner.nekomata-map"
rm -f "$manifest_path"
manifest_ready=0
if [ -n "$CLI" ]; then
  # A build without DWARF inspection has a CLI without `manifest`, and that is
  # a supported configuration: the two cases below are skipped rather than
  # failed, and the rest of the suite is unaffected.
  if "$CLI" manifest "$HERE/reject_runner" > "$manifest_path" 2>/dev/null; then
    manifest_ready=1
  else
    rm -f "$manifest_path"
  fi
fi

"$HERE/reject_runner" "$WORK/bad.new.o" "$STOP_FILE" > "$OUT" 2>&1 &
runner_pid=$!
wait_for '\[hot\] tick' 2 startup 0
if [ "$manifest_ready" = 1 ]; then
  wait_for "symbol manifest loaded" 2 manifest_loaded 0
fi

# 1. garbage bytes
head -c 100 /dev/urandom > "$WORK/staging.o"
expect_case garbage "$WORK/staging.o" "bad magic"

# 2. empty file
: > "$WORK/staging.o"
expect_case empty "$WORK/staging.o" "truncated object file"

# 3. truncated valid object
head -c 60 "$WORK/baseline.o" > "$WORK/staging.o"
expect_case truncated "$WORK/staging.o" "truncated object file"

# 4. wrong optimization flags (the classic user mistake). Probe result:
# a single self-contained TU at -O2 applies CLEANLY today — the prologue
# guard checks the OLD entry (built -O0), and the fresh -O2 body needs no
# prologue at all, just valid relocations. We pin that truth and the real
# invariant: state continuity, no crash. (-O2 is NOT a supported config —
# cross-TU inlining will reject loudly once it appears.)
"$CXX" -std=c++20 -O2 -fno-pie -fno-pic -fno-exceptions \
  -fno-asynchronous-unwind-tables -c "$SRC/hot.cpp" -o "$WORK/staging.o"
o2_cursor=$(log_cursor "$OUT")
mv "$WORK/staging.o" "$WORK/bad.new.o"
wait_for "reload applied" 15 flags_o2 "$o2_cursor"
o2_ticks_before=$(count '\[hot\] tick')
sleep 0.6
alive || { echo "FAIL(flags_o2): runner died on the -O2 reload"; exit 1; }
o2_ticks_after=$(count '\[hot\] tick')
[ "$o2_ticks_after" -gt "$o2_ticks_before" ] || {
  echo "FAIL(flags_o2): ticks did not continue after -O2 reload"; exit 1; }
echo "PASS flags_o2_applies_incidentally"

# 5. fresh code introduces a new mutable global
build_variant 's|static int s_calls = 0;|static int s_calls = 0; int g_extra = 1;|; s|++g_counter;|++g_counter; g_extra += 2;|'
expect_case new_global "$WORK/staging.o" "new globals are not supported yet"

# 6. cross-TU call into the host program. `host_only` is defined in the
#    runner and never exported, so this only resolves if the process's own
#    symbol table is consulted — the same table the patch path already trusts
#    for the functions it redirects. It used to be refused, which made a
#    function reachable for patching but not for calling.
build_variant 's|#include <cstdio>|#include <cstdio>\nvoid host_only();|; s|++s_calls;|++s_calls; host_only();|'
cross_cursor=$(log_cursor "$OUT")
mv "$WORK/staging.o" "$WORK/bad.new.o"
wait_for "reload applied" 15 cross_tu "$cross_cursor"
wait_for '\[host\] host_only called' 15 cross_tu_called "$cross_cursor"
cross_ticks_before=$(count '\[hot\] tick')
sleep 0.6
alive || { echo "FAIL(cross_tu): runner died after the reload"; exit 1; }
cross_ticks_after=$(count '\[hot\] tick')
[ "$cross_ticks_after" -gt "$cross_ticks_before" ] || {
  echo "FAIL(cross_tu): ticks did not continue after the reload"; exit 1; }
echo "PASS cross_tu_calls_the_host"

# 7. a reference that exists nowhere: still refused, and the message says what
#    is missing rather than blaming cross-TU references, which work now.
build_variant 's|#include <cstdio>|#include <cstdio>\nvoid missing_everywhere();|; s|++s_calls;|++s_calls; missing_everywhere();|'
#    The name in the message is the object's symbol, which for C++ is the
#    mangled one; demangling the diagnostic is a separate change.
expect_case cross_tu_missing "$WORK/staging.o" "cannot resolve external symbol '_Z18missing_everywherev'"

if [ "$manifest_ready" = 1 ]; then

# 8. A fresh file-static helper whose name the process also uses under another
#    source. This watcher deliberately supplies no source identity, so even a
#    loaded manifest cannot authorize a name-only redirect. The process must
#    survive the refusal with the old code still running.
build_variant 's|#include <cstdio>|#include <cstdio>\nstatic int helper() { return 7; }|; s|++g_counter;|g_counter += helper();|'
expect_case ambiguous_not_confirmed "$WORK/staging.o" "ambiguous function"
echo "PASS manifest_confirms_or_refuses"

else
  echo "SKIP manifest_confirms_or_refuses (no --cli)"
fi

# 10. existing global changed size (int -> long): layout drift must be
#    caught by the data-section anchor consistency check
build_variant 's|int g_counter = 0;|long g_counter = 0;|'
expect_case size_change "$WORK/staging.o" "inconsistent state anchors — the global layout changed"

# 11. GOT-style relocations (-fpic hot TU)
"$CXX" -std=c++20 -O0 -fpic -fno-exceptions -fno-asynchronous-unwind-tables \
  -c "$SRC/hot.cpp" -o "$WORK/staging.o"
expect_case got_style "$WORK/staging.o" "GOT-style relocs need -fno-pic"

# 12. arena boundary: image sections sized so the laid-out image stays
#    within one page while at least one trampoline slot follows (printf
#    remains an undefined call). The reservation must cover the trampoline
#    bytes; before the fix the commit wrote past the reserved page span.
#    Runs in a FRESH runner process so the arena is the process's first
#    mapping: its neighbor page is unmapped and the old out-of-span write
#    faults (SIGSEGV in commit_code). In the long-lived runner above, prior
#    arenas would neighbor the overflow and mask it. Regression gate: the
#    reload must apply cleanly and state must continue, not just "not crash".
build_arena_variant 4096 "$WORK/boundary.o"
boundary_log="$WORK/boundary_out.txt"
: > "$boundary_log"
"$HERE/reject_runner" "$WORK/boundary.new.o" "$WORK/boundary_stop" >> "$boundary_log" 2>&1 &
boundary_pid=$!
wait_for_new '\[hot\] tick' 15 boundary_startup "$boundary_log" 0
# Take the cursor BEFORE publishing the object: the runner may claim and
# apply it immediately, and a cursor taken after the mv would already
# include the "reload applied" line, waiting forever for a newer one.
boundary_cursor=$(log_cursor "$boundary_log")
mv "$WORK/boundary.o" "$WORK/boundary.new.o"
wait_for_new "reload applied" 15 arena_boundary "$boundary_log" "$boundary_cursor"
boundary_ticks=$(grep -c '\[hot\] tick' "$boundary_log" || true)
sleep 0.6
kill -0 "$boundary_pid" 2>/dev/null || {
  echo "FAIL(arena_boundary): runner died on the boundary-sized reload"; exit 1; }
boundary_after=$(grep -c '\[hot\] tick' "$boundary_log" || true)
[ "$boundary_after" -gt "$boundary_ticks" ] || {
  echo "FAIL(arena_boundary): ticks did not continue after the boundary reload"; exit 1; }
finish_runner "$boundary_pid" "$WORK/boundary_stop" "$boundary_log"
echo "PASS arena_boundary"

# ---- a VALID reload must still work after all the abuse ------------------
build_variant 's|++g_counter;|g_counter += 10;|; s|\[hot\]|[recovered]|'
final_cursor=$(log_cursor "$OUT")
mv "$WORK/staging.o" "$WORK/bad.new.o"
wait_for "reload applied" 15 final_valid "$final_cursor"
wait_for_new '\[recovered\] tick' 15 final_valid "$OUT" "$final_cursor" 3
alive || { echo "FAIL(final_valid): runner died on the valid reload"; exit 1; }

finish_runner "$runner_pid" "$STOP_FILE" "$OUT"
runner_pid=""

# Check real execution and both state anchors, not just the reload message.
awk '
  /\[hot\] tick/ {
    if (recovered) exit 1
    split($3, call, "[# ,]"); split($4, counter, "=")
    calls = call[2]; value = counter[2]; baseline = 1
  }
  /\[recovered\] tick/ {
    split($3, call, "[# ,]"); split($4, counter, "=")
    if (!baseline || call[2] != calls + 1 || counter[2] != value + 10) exit 1
    calls = call[2]; value = counter[2]; recovered++
  }
  END { if (recovered < 3) exit 1 }
' "$OUT" || { echo "FAIL(final_valid): new logic or state continuity is incorrect"; exit 1; }
echo "PASS valid_reload_after_abuse"

echo ""
echo "ALL REJECTION CASES PASS — every boundary rejected loudly, process survived"
echo "output kept at: $OUT"
