#!/usr/bin/env bash
# Rebuild hot.cpp with exactly the flags that linked the original binary.
# Generated by CMake — the Phase 1 answer to "build information".
set -euo pipefail
"@CMAKE_CXX_COMPILER@" -std=c++20 -O0 -fno-pie -fno-pic -fno-exceptions \
  -fno-asynchronous-unwind-tables -c "$1" -o "$2"
