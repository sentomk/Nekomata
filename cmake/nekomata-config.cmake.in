# nekomata package configuration. The exported targets file carries its own
# relocation; only the thread dependency needs resolving up front.
include(CMakeFindDependencyMacro)
if(NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Emscripten")
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nekomata-targets.cmake")
