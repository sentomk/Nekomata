# clangd configuration — https://clangd.llvm.org/config
#
# Compile commands come from the CMake presets (CMAKE_EXPORT_COMPILE_COMMANDS
# is ON in every preset). `build/debug` is the default database; re-run
# `cmake --preset debug` after adding/removing files or changing flags.
#
# Note: the ELF backend (backends/elf/) is Linux-gated, so on other platforms
# those files are absent from the database and clangd will complain about
# <elf.h> — that is expected; index them from a Linux checkout (the dev box
# builds the same layout at ~/Nekomata/build/debug) or ignore locally.

CompileFlags:
  CompilationDatabase: build/debug
  # Fallback aid for files not in the database (fresh headers before the next
  # configure, kernel code on any platform): the standard, the public include
  # tree, and the generated version header.
  Add:
    - -std=c++20
    - -Iinclude
    - -Ibuild/debug/generated

Completion:
  # Offer completions from all visible namespaces (e.g. `symbol_provider`
  # after `neko::`), not just the current scope.
  AllScopes: true

InlayHints:
  ParameterNames: Yes
  DeducedTypes: Yes

Diagnostics:
  # Include hygiene for our own headers; MissingIncludes stays off because
  # the fallback path (no database entry) would produce false positives.
  UnusedIncludes: Strict
  MissingIncludes: None
